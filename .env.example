# Copy this to ".env" and fill it in. NEVER commit your real .env.
# Load it locally with:  set -a && source .env && set +a

# --- Required ---
GROQ_API_KEY=your_groq_key_here

# Email delivery (defaults target Gmail). SMTP_PASSWORD must be an APP PASSWORD,
# not your normal login password. For Gmail: enable 2-step verification, then
# create an app password at https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# --- Optional (sensible defaults exist) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_FROM=you@gmail.com        # defaults to SMTP_USER
# EMAIL_TO=you@gmail.com          # defaults to SMTP_USER; comma-separated for several
# GROQ_MODEL=llama-3.3-70b-versatile
# COSTCO_INTERESTS=no-sugar foods, high-protein foods, kitchen gadgets, home organization
# COSTCO_REGION=San Francisco Bay Area, California
# LOOKBACK_HOURS=30
# REDDIT_SUBS=Costco
# RSS_FEEDS=https://example-costco-blog.com/feed/,https://another.com/feed/
# SEND_IF_EMPTY=false
# SEEN_DB=                        # set a path (e.g. seen.db) only on a persistent host
#
# --- Costco.com new arrivals (opt-in, paid scraper API) ---
# Set SCRAPER_API_KEY to turn this source on; leave it unset to skip Costco.com entirely.
# SCRAPER_API_KEY=your_scrapingbee_key_here
# SCRAPER_ENDPOINT=https://app.scrapingbee.com/api/v1/   # override only for a different provider
# COSTCO_ONLINE_URLS=https://www.costco.com/whats-new.html   # verify in a browser; comma-separate for more
